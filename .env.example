# Agent Office 로컬 설정 예시 — 필요한 줄만 .env.local로 복사해 쓰세요(.env.local은 git에 올라가지 않아요).
# 비밀번호·API 키는 넣지 않아요. Claude 로그인은 claude CLI에서 직접 합니다.

# 서버 (기본: 이 컴퓨터에서만 접속)
# HOST=127.0.0.1
# PORT=4317
# DATA_DIR=./data

# 처음 켤 때의 AI 연결: fake(가짜 AI, 기본) | claude-cli(내 Claude 구독)
# 화면의 설정에서 바꾸면 그 값이 저장돼 우선합니다.
# AI_PROVIDER=fake

# Claude 구독(Claude Code CLI)
# CLAUDE_BIN=claude                    # claude 실행 파일 경로
# CLAUDE_MODEL=                         # 비우면 Claude Code 기본값(예: sonnet, opus)
# CLAUDE_MAX_BUDGET_PER_RUN_USD=1       # 한 번 실행의 비용 상한(API 환산 추정)
# CLAUDE_TIMEOUT_MS=600000              # 한 번 실행 시간 제한(10분)
# CLAUDE_CONCURRENCY=1                  # 동시에 실행할 업무 수

# 이번 주 AI 사용 상한(API 환산 추정, USD). 넘으면 새 업무를 시작하지 않고 '한도 대기'
# WEEKLY_BUDGET_USD=

# 가짜 AI(흐름 확인용)
# FAKE_SPEED_MS=2500                    # 업무 하나 평균 시간
# FAKE_QUOTA_UNITS=100                  # 가짜 한도(작게 하면 한도 대기 흐름을 볼 수 있어요)
# FAKE_RESET_MIN=10                     # 가짜 한도 재설정 주기(분)
# FAKE_FAIL_RATE=0                      # 일시 오류 확률(0–1, 재시도 흐름 확인용)

# 실행기
# TICK_MS=500
# HANDOFF_ACCEPT_MS=1500                # 인계를 받는 직원이 자료를 확인하는 데 걸리는 시간
# MAX_ATTEMPTS=3                        # 일시 오류 재시도 횟수

# 연결 토큰 암호화 키(선택, base64 32바이트). 없으면 data/secret.key를 만들어 써요(지우면 연결을 다시 해야 해요).
# AO_SECRET_KEY=
